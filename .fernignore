# Specify files that shouldn't be modified by Fern
README.md
banner.png
changelog.md

# WireMock stubs for /ecommerce/attribution/metrics were generated with RFC3339_EXTENDED
# datetime format (.000Z) but the PHP serializer uses RFC3339 (Z). The equalTo matchers
# would never match, causing BrevoApiException in CI. Fixed to use Z without milliseconds.
# Protected until Fern fixes the datetime format inconsistency in the PHP generator.
wiremock/wiremock-mappings.json

# v4 maintenance backports applied by hand (not via Fern regeneration). These spec-driven
# type fixes (#137 senderEmail nullable, #136 campaignId nullable) and the #133 Guzzle
# timeout fix (interface_exists) are protected so an accidental regen on the frozen v4 line
# cannot revert them. The v5 line gets the same fixes via openapi-overlays instead.
src/TransactionalEmails/Types/GetTransacBlockedContactsResponseContactsItem.php
src/Contacts/Types/GetContactInfoResponseStatisticsUnsubscriptionsUserUnsubscriptionItem.php
src/Contacts/Types/GetContactStatsResponseUnsubscriptionsUserUnsubscriptionItem.php
src/Core/Client/RetryDecoratingClient.php
